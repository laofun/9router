FROM node:20-alpine
WORKDIR /app

LABEL org.opencontainers.image.title="9router"
LABEL org.opencontainers.image.description="9Router runtime from public npm package"

ENV NODE_ENV=production
ENV PORT=20128
ENV HOSTNAME=0.0.0.0
ENV DATA_DIR=/app/data
ENV LAN_MODE=true
ENV NEXT_TELEMETRY_DISABLED=1

RUN npm install -g --no-audit --no-fund 9router@latest
RUN mkdir -p /app/data

# Fix permissions at runtime for mounted volumes.
RUN printf '#!/bin/sh\nchown -R node:node /app/data 2>/dev/null; exec su-exec node "$@"\n' > /entrypoint.sh && chmod +x /entrypoint.sh
RUN apk add --no-cache su-exec

EXPOSE 20128

ENTRYPOINT ["/entrypoint.sh"]
CMD ["9router"]
